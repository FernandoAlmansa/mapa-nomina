_PROCESSOR"],"externo":[],"ficha":["Ganancias de 4ta categoría. FUARTAX solo crea CL_HRPAYAR_TAX_CALC_PROCESSOR; el cálculo está en sus clases locales.","No calcula nada (la IT sale igual) si ARIMP-IMPUE no está marcado o si es un off-cycle de anticipo especial o de anticipo sin impuesto.","La ley se elige por fecha de pago con T5F99K2: método 1 = Ley 27.743; vacío o 0 = Ley 27.725 (cedular: mínimo exento 15 SMVM × mes, SMVM de T511P SMVMN/SMVMS).","Ley 27.743, todo acumulado anual (IT + CRT anual): bruta = /156 + OEGB (otros empleadores) + SAC (/4S0 /4S1 /4S2 /4S4 /4S6) − aportes (AP01 AP12). Deducciones = D156 + DP01 + DG01 + DP12 + OEDG, con tope en la bruta → /4T8. Neta sujeta /4T0 = bruta − /4T8.","Escala T7ARTAX_RANGES grupo 01 (99 si es liquidación final): /4T1 = fijo + % × excedente (cantidad de /4T1 = alícuota). Impuesto del mes /4T2 = /4T1 − /4T2 ya retenido en el año − retenciones de otros empleadores − PAC (negativo = devolución)."]},"ARTEC":{"form":"FUARTEC","include":"PCARTEC","lineas":451,"parametros":[],"tablas":[],"conceptos":[],"clases":[],"constantes":[],"modulos":["HRAR_GET_PAYROLL_PERIOD","HRAR_READ_RGDIR_PAYRESULTS","HRAR_SUBTRACT_MONTH_TO_DATE","HR_AR_HIRE_FIRE"],"clases_globales":["CL_HR_TERMINATION_IN_CUOTAS_AR"],"externo":[]},"ARTEP":{"form":"FUARTEP","include":"PCMASARP","lineas":722,"parametros":[],"tablas":["T511K","T7AR90"],"conceptos":["/222","/S07"],"clases":[],"constantes":[],"modulos":["HRAR_TERMINATION_DATA","HR_AR_HIRE_FIRE"],"clases_globales":[],"externo":[]},"ARTER":{"form":"FUARTER","include":"PCMASART","lineas":1082,"parametros":[],"tablas":["T7AR90"],"conceptos":["/T01","/T02","/T03"],"clases":[],"constantes":[],"modulos":["HRAR_TERMINATION_ANTIGUEDAD","HRAR_TERMINATION_DATA","HRAR_TERMINATION_RET7AR97","HR_AR_HIRE_FIRE","HR_PERSONAL_WORK_SCHEDULE"],"clases_globales":[],"externo":[]},"ARTXA":{"form":"FUARTXA","include":"PCMASARX","lineas":33,"parametros":[],"tablas":[],"conceptos":[],"clases":[],"constantes":[],"modulos":[],"